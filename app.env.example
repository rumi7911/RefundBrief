# RefundBrief configuration — copy to app.env.local (git-ignored) and fill in.
# The app runs as an honest SAMPLE with none of these set: sample cases are
# simulated locally and never call PayPal. Nothing here is invented at runtime.

# ---- PayPal sandbox (required only for real, owner-owned captures) ----
# Sandbox only. A live host (api-m.paypal.com) is refused at startup.
# See docs/sandbox-setup.md for how to obtain these.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The business merchant ID that must own every capture (not the buyer's ID).
PAYPAL_MERCHANT_ID=
# Optional. Defaults to https://api-m.sandbox.paypal.com; must stay a sandbox URL.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ---- Live AI brief generation (optional; opt-in and funding-gated) ----
# Live generation stays OFF unless ALL of the following are set. Inherited
# ANTHROPIC_API_KEY / OPENAI_API_KEY are deliberately IGNORED — supply the key
# explicitly as REFUNDBRIEF_AI_KEY so no ambient credential is ever spent.
AI_ALLOW_REQUESTS=false
# AI_PROVIDER=anthropic        # 'anthropic' or 'openai'
# AI_MODEL=                     # explicit model id (no guessed 'latest')
# REFUNDBRIEF_AI_KEY=           # the provider key to use for this app only
# AI_BASE_URL=                  # optional https gateway override

# ---- Operational ----
# PORT=4100
